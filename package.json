  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "ajv": "^8.17.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
