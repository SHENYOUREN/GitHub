{
  "name": "hierarchical-a2a-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "A hierarchical A2A control plane for Codex, DeepSeek Harness, and future AI clients.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "node scripts/run-tests.mjs source",
    "smoke": "tsx scripts/smoke.ts",
    "test:compiled": "tsc --outDir .build --noEmit false && node scripts/run-tests.mjs compiled",
    "verify:compat": "npm run test:compiled && node .build/scripts/smoke.js",
    "verify:handoff": "node scripts/static-check.mjs && npm run verify:compat",
    "verify:win10": "node scripts/windows-compat-check.mjs && npm run verify:handoff"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "ajv": "^8.17.1",
    "express": "^5.1.0",
    "lucide-static": "^0.545.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
