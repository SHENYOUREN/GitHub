{
  "name": "@local/taskroom-session-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open the connected task-room worker session in the DSH Web GUI.",
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
